# Copy this file to .env.local and fill in real values for local dev.
# Both NEXT_PUBLIC_* vars are read by frontend/lib/api.ts at runtime (exposed to the browser).
# Live deployed endpoints (ap-southeast-1) — safe to point dev at these.
NEXT_PUBLIC_UPLOAD_API=https://bj0iusoe6a.execute-api.ap-southeast-1.amazonaws.com/prod/upload
NEXT_PUBLIC_RESULTS_API=https://axxsy44fvk.execute-api.ap-southeast-1.amazonaws.com/prod/results

# ── Admin audit panel (/admin) ────────────────────────────────────────────────
# Required only for the admin audit trail page. The /admin page runs via
# `npm run dev` only — it is excluded from the static export (npm run build).
# Find the table name in AWS Console → DynamoDB → Tables, or in the CDK output
# for CaptureStack (look for "SubmissionsTableName").
SUBMISSIONS_TABLE_NAME=your-submissions-table-name

# AWS credentials with read access to the Submissions table.
# Recommended: create a dedicated IAM user with GetItem + Scan on that table only.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
